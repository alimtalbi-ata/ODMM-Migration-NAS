# TLS proxy example. Substitute host and certificate paths with approved values.
# No authentication headers may be trusted from clients.
server {
    listen 443 ssl;
    server_name odmm.example.invalid;
    ssl_certificate /etc/odmm/tls/fullchain.pem;
    ssl_certificate_key /etc/odmm/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "";
        proxy_hide_header X-Powered-By;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
